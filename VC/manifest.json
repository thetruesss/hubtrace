{
  "manifest_version": 3,
  "name": "Hub Trace",
  "version": "2.4.0",
  "description": "Ищет склад в истории Hub по номерам отправлений",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Hub Trace",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hub.o3t.ru/*"],
      "js": ["netprobe.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://hub.o3t.ru/*"],
      "js": ["scanner.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "permissions": ["tabs", "scripting", "storage", "windows", "notifications"],
  "host_permissions": ["https://hub.o3t.ru/*"]
}
