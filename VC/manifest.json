{
  "manifest_version": 3,
  "name": "Hub Trace",
  "version": "2.39.0",
  "description": "Корректировщик расстановки ответственности OnTime",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Hub Trace",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hub.o3t.ru/*"],
      "js": ["netprobe.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://hub.o3t.ru/*"],
      "js": ["scanner.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "permissions": ["tabs", "scripting", "storage", "notifications"],
  "host_permissions": ["https://hub.o3t.ru/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "{eeeb1f98-effb-41ee-84b1-b46568f21b0f}",
      "strict_min_version": "128.0",
      "update_url": "https://cdn1.ozone.ru/s3/ozon-browser-extensions-public/updates.json",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
